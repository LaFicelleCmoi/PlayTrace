# Sécurité de la chaîne d'approvisionnement (vers npm de 2025 : paquets populaires compromis
# qui volaient des jetons via leurs scripts d'installation).
# Aucun script postinstall n'est exécuté ; esbuild fonctionne sans grâce à ses binaires optionnels.
ignore-scripts=true
# Versions exactes : une nouvelle version piégée n'est jamais installée sans le vouloir.
save-exact=true
