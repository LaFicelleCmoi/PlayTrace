# Clé API Steam : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=ta_cle_api_steam
# Postgres Supabase (pooler en mode transaction, port 6543), rôle playtrace_app
DATABASE_URL=postgresql://playtrace_app.<ref>:<mot_de_passe>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
PORT=3000
# URL vue par le navigateur (Vite en dev, le serveur Node en production)
BASE_URL=http://localhost:5173
# Au moins 32 caractères aléatoires : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=une_longue_chaine_aleatoire_d_au_moins_32_caracteres
# Minimum 30000
POLL_INTERVAL_MS=60000
# Jeton exigé par GET /api/cron/poll (appelé chaque minute par pg_cron sur Supabase)
CRON_SECRET=jeton_du_cron
# Jeton partagé entre l'agent local (npm run agent) et le site déployé
AGENT_TOKEN=jeton_de_l_agent
# Site vers lequel l'agent envoie les téléchargements
AGENT_URL=https://play-trace-nine.vercel.app
# Optionnels, pour les téléchargements en cours (détectés automatiquement sinon) :
# dossier du client Steam et compte qui voit ses téléchargements
# STEAM_PATH=/mnt/c/Program Files (x86)/Steam
# STEAM_LOCAL_STEAMID=7656119XXXXXXXXXX
